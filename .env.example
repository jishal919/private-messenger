# Core database (required)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Message storage shards (JSON array). Create one content database and schema
# per shard; connection.url and connection.authToken are read by the server.
CONTENT_SHARDS_CONFIG=[{"id":"primary","provider":"turso","connection":{"url":"libsql://your-content-db.turso.io","authToken":"replace-with-content-database-token"},"enabled":true,"priority":1}]

# ImageKit avatar storage
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ImageKit voice message storage (may use a separate account)
IMAGEKIT_PUBLIC_KEY_VOICE=public_xxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY_VOICE=private_xxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT_VOICE=https://ik.imagekit.io/your_voice_imagekit_id

# Web push notifications (generate a VAPID key pair)
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-the-same-vapid-public-key

# Backblaze B2 media storage. Set all four values for each category you use.
B2_IMAGES_KEY_ID=replace-with-key-id
B2_IMAGES_APPLICATION_KEY=replace-with-application-key
B2_IMAGES_BUCKET=your-images-bucket
B2_IMAGES_ENDPOINT=https://s3.region.backblazeb2.com

B2_VIDEOS_KEY_ID=replace-with-key-id
B2_VIDEOS_APPLICATION_KEY=replace-with-application-key
B2_VIDEOS_BUCKET=your-videos-bucket
B2_VIDEOS_ENDPOINT=https://s3.region.backblazeb2.com

B2_DOCUMENTS_KEY_ID=replace-with-key-id
B2_DOCUMENTS_APPLICATION_KEY=replace-with-application-key
B2_DOCUMENTS_BUCKET=your-documents-bucket
B2_DOCUMENTS_ENDPOINT=https://s3.region.backblazeb2.com

# Optional cleanup and upload limits
CRON_SECRET=replace-with-a-long-random-secret
MEDIA_RETENTION_DAYS=30
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=25
